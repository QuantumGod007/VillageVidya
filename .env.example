# Default to the fictional demo. Set supabase for provisioned adult test sign-in.
VITE_APP_MODE=demo
# Public client configuration only; npm run auth:configure creates local values:
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put service-role/secret keys or database passwords in VITE_* variables.
# Database tests use an isolated local DB only (not a linked/production project):
VV_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
